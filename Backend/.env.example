# Backend environment variables

NODE_ENV=development

# MongoDB
MONGO_URI=

# Auth
JWT_SECRET=

# Frontend
FRONTEND_URL=http://localhost:5173

# Groq (AI)
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-70b-versatile

# Optional: vector DB
CHROMA_URL=http://localhost:8000

# Upload limits
MAX_FILE_SIZE=50MB

# Server
PORT=5000

