# ==============================================================================
# ELearnAI Backend Environment Configuration
# Copy this file to .env and configure the values for your environment.
# ==============================================================================

# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration (MongoDB)
# Supports MONGO_URI or MONGODB_URI
MONGODB_URI=mongodb://localhost:27017/elearnai
MONGO_URI=mongodb://localhost:27017/elearnai

# Authentication & Security
# Generate secure random strings: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your_super_secret_jwt_access_token_key_here
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=your_super_secret_jwt_refresh_token_key_here
JWT_REFRESH_EXPIRES_IN=30d

# Frontend URL (CORS & Email Links)
FRONTEND_URL=http://localhost:5173

# AI Service (Groq)
# Get your free key at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=groq/compound

# Vector Database (Optional - falls back to in-memory + MongoDB Lesson RAG)
CHROMA_URL=http://localhost:8000

# File Upload Limits
# Accepts plain bytes or unit strings: e.g. 50MB, 25MB, 100MB
MAX_FILE_SIZE=50MB

# Email Service Configuration (Optional: Password Reset & Welcome Emails)
# Uses standard SMTP or ethereal for dev testing
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=587
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password
EMAIL_FROM="ELearnAI Support" <noreply@elearnai.com>
