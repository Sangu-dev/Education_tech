# Copy this file to .env
# Example configuration (do NOT commit your real secrets)

NODE_ENV=development
PORT=5000

# MongoDB
MONGODB_URI=

# JWT
JWT_SECRET=
JWT_REFRESH_SECRET=

# Email (optional)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=

# GROQ (required for AI features)
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-70b-versatile

