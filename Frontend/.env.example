# ==============================================================================
# ELearnAI Frontend Environment Configuration
# Copy this file to .env and configure the values for your environment.
# Note: In development with Vite proxy, VITE_API_URL can remain unset to use relative /api
# ==============================================================================

# API Base URL (Leave empty or set to /api if using Vite proxy; set full URL in production)
# VITE_API_URL=http://localhost:5000/api
VITE_API_URL=
